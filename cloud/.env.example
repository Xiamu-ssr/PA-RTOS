# Copy values into the private environment file created by npm run init.
PA_ROOT=/var/lib/pa-rtos
PA_HOST=127.0.0.1
PA_PORT=19870
PA_GATEWAY_PORT=19871
# Direct HTTPS can use an IP certificate; a domain is optional.
PA_TLS_CERT=
PA_TLS_KEY=
# The init command generates both tokens; keep them outside this repository.
PA_GATEWAY_TOKEN=
PA_MODEL_PROVIDER=custom
PA_MODEL_API=openai-completions
PA_MODEL_BASE_URL=https://models.example.com/v1
PA_MODEL_ID=your-model-id
PA_MODEL_API_KEY=
PA_MODEL_CONTEXT_WINDOW=32000
PA_MODEL_MAX_TOKENS=2048
PA_REQUEST_TIMEOUT_MS=180000
